# CognoDB
COGNO_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNO_USER=cognodb
COGNO_PASSWORD=your_password

# Neo4j (Aura Free)
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Memgraph (Cloud)
MEMGRAPH_URI=bolt://<instance-id>.memgraph.cloud:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=your_password

# ArangoDB (Oasis)
ARANGO_URL=https://<instance-id>.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=your_password
ARANGO_DATABASE=benchmark

# Concurrency Settings
CONCURRENCY_LEVELS=1,10,40
WARMUP_RUNS=20
